# Local development only. Never copy production secrets into this file.
NODE_ENV=development
PORT=9901
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
BETTER_AUTH_URL=http://localhost:3100/api/auth
BETTER_AUTH_SECRET=replace-with-a-random-local-secret-at-least-32-characters
PUBLIC_BACKEND_URL=

# Preferred SQLite/libSQL database configuration. Use separate databases and
# credentials for development, staging, and production.
TURSO_DATABASE_URL=libsql://example-development.turso.io
TURSO_AUTH_TOKEN=replace-with-a-development-token

# Optional legacy Skybase fallback (do not set together with Turso).
# SKYBASE_DB_ENDPOINT=
# SKYBASE_DB_AUTH_TOKEN=
# SKYBASE_DB_NAMESPACE=

# Distributed protection. Production is configured to fail startup if these
# are missing. Trust only Render's forwarded client-IP header when deployed there.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-development-token
RATE_LIMIT_TRUST_RENDER_PROXY=false

# Conservative call-count safeguards. These are not monetary budgets because
# the Skywork bridge does not expose verified price/usage accounting to this app.
PUBLIC_AI_MAX_OUTPUT_TOKENS=512
PUBLIC_AI_MAX_CONCURRENT_REQUESTS=2
PUBLIC_AI_MAX_CALLS_PER_DAY=50
PUBLIC_AI_REQUESTS_PER_IP_PER_MINUTE=5

# Existing server-side integrations; fill only in the local process environment.
SKYWORK_GATEWAY_BASE_URL=https://api-inn.skywork.ai/gateway
SKYWORK_AI_BASE_URL=https://api.skywork.ai/skycowork-llm/
SKYWORK_API_TOKEN=replace-with-a-development-token
RESEND_API_KEY=replace-with-a-development-token
EMAIL_FROM=Leticia <noreply@example.invalid>
STORAGE_MAX_UPLOAD_BYTES=5242880
STORAGE_MAX_IMAGE_PIXELS=16000000
STORAGE_PROVIDER=skywork

# Render/Pages public build setting; this value is public, never a secret.
VITE_API_BASE_URL=https://api.example.invalid

# Optional R2 adapter settings. Use an isolated test bucket for staging.
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=example-account-id
# R2_ACCESS_KEY_ID=replace-with-a-development-key-id
# R2_SECRET_ACCESS_KEY=replace-with-a-development-secret
# R2_BUCKET=leticia-staging-private
