{
  "name": "coding-agent-web-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "test:infra": "vitest run --project=server apps/server/_test/infra",
    "test:integration": "vitest run --project=server apps/server/__tests__",
    "test:client": "vitest run --project=client",
    "build": "node scripts/build-root-fast-fail.mjs",
    "check:contract": "node scripts/check-agents-contract.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.2",
      "nanoid": "3.3.20",
      "postcss": "8.5.32",
      "source-map-js": "1.2.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "browserslist": "4.29.5",
      "js-yaml": "4.3.2",
      "esbuild": "0.28.2",
      "mysql2": "3.23.1",
      "@hono/node-server": "2.1.5",
      "postcss-selector-parser": "6.1.5",
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.5.3",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vitest": "^4.1.12"
  }
}
